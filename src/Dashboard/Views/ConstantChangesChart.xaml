<UserControl x:Class="RealTimeInfoDashboard.Views.ConstantChangesChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="900">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Toggle button -->
        <Button Grid.Row="0" Grid.Column="1"
                Command="{Binding ToggleDataReadingCommand}"
                Content="Start / Stop"
                Padding="8,4" Margin="0,0,0,4"/>

        <!-- ═══════ Custom Angular Gauge (pure WPF) ═══════ -->
        <Viewbox Grid.Row="1" Grid.Column="0" Stretch="Uniform"
                 Margin="4" VerticalAlignment="Center">
            <!--
                Canvas coordinate system:
                  Centre = (100, 105)
                  Outer radius = 75,  Inner radius = 45
                  Arc spans 180° → 0° (left → right through top)
                  Value 60 @ 180°,  70 @ 120°,  80 @ 60°,  90 @ 0°
            -->
            <Canvas Width="200" Height="135" ClipToBounds="False">

                <!-- DarkRed  (60 → 65) -->
                <Path Fill="#8B0000"
                      Data="M 25,105
                            A 75,75 0 0 1 35.05,67.5
                            L 61.03,82.5
                            A 45,45 0 0 0 55,105 Z"/>

                <!-- Orange   (65 → 70) -->
                <Path Fill="#FFA500"
                      Data="M 35.05,67.5
                            A 75,75 0 0 1 62.5,40.05
                            L 77.5,66.03
                            A 45,45 0 0 0 61.03,82.5 Z"/>

                <!-- Green    (70 → 85) -->
                <Path Fill="#228B22"
                      Data="M 62.5,40.05
                            A 75,75 0 0 1 164.95,67.5
                            L 138.97,82.5
                            A 45,45 0 0 0 77.5,66.03 Z"/>

                <!-- Orange   (85 → 90) -->
                <Path Fill="#FFA500"
                      Data="M 164.95,67.5
                            A 75,75 0 0 1 175,105
                            L 145,105
                            A 45,45 0 0 0 138.97,82.5 Z"/>

                <!-- Needle (rotates around the centre point) -->
                <Line X1="100" Y1="40" X2="100" Y2="105"
                      Stroke="#1E293B" StrokeThickness="2.5"
                      StrokeStartLineCap="Triangle" StrokeEndLineCap="Round">
                    <Line.RenderTransform>
                        <RotateTransform Angle="{Binding NeedleAngle}"
                                         CenterX="100" CenterY="105"/>
                    </Line.RenderTransform>
                </Line>

                <!-- Pivot dot -->
                <Ellipse Width="12" Height="12" Fill="#334155"
                         Canvas.Left="94" Canvas.Top="99"/>

                <!-- Range labels -->
                <TextBlock Text="60" FontSize="11" Foreground="#64748B"
                           Canvas.Left="5"  Canvas.Top="98"/>
                <TextBlock Text="70" FontSize="11" Foreground="#64748B"
                           Canvas.Left="46" Canvas.Top="22"/>
                <TextBlock Text="80" FontSize="11" Foreground="#64748B"
                           Canvas.Left="140" Canvas.Top="22"/>
                <TextBlock Text="90" FontSize="11" Foreground="#64748B"
                           Canvas.Left="180" Canvas.Top="98"/>

                <!-- Numeric readout -->
                <TextBlock Text="{Binding Efficiency, StringFormat='{}{0:F1}'}"
                           FontSize="20" FontWeight="SemiBold" Foreground="#1E293B"
                           Canvas.Left="65" Canvas.Top="110"/>
            </Canvas>
        </Viewbox>

        <!-- ═══════ Cartesian Chart ═══════ -->
        <lvc:CartesianChart Grid.Row="1" Grid.Column="1"
                            Series="{Binding ChartSeries}"
                            XAxes="{Binding XAxes}"
                            YAxes="{Binding YAxes}"
                            TooltipPosition="Hidden"
                            AnimationsSpeed="00:00:00.100"
                            Margin="0,0,4,4"/>
    </Grid>
</UserControl>
